# Copy to .env and fill in. NEVER commit .env.

# ───────── Core ─────────
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_TIMEZONE=Asia/Kolkata
# Set to true when served over HTTPS (required in production)
COOKIE_SECURE=false
# Comma-separated origins allowed to call the API from a browser
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ───────── Gemini ─────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_CALLS=6
AGENT_TOTAL_TIMEOUT_SECONDS=75

# ───────── Application database (users, chats, audit) ─────────
APP_DB_HOST=127.0.0.1
APP_DB_PORT=3306
APP_DB_NAME=omniagent_app
APP_DB_USER=omniagent_app
APP_DB_PASSWORD=change-me-app

# ───────── Domain databases (READ-ONLY account) ─────────
DOMAIN_DB_HOST=127.0.0.1
DOMAIN_DB_PORT=3306
DOMAIN_DB_READONLY_USER=omniagent_ro
DOMAIN_DB_READONLY_PASSWORD=change-me-readonly

# ───────── One-time setup only (not used by the running server) ─────────
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
# Host part for the MySQL users created by setup ('localhost' or '%')
MYSQL_USER_HOST=localhost
# Admin account created by `python -m scripts.setup all` (prompted if empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ───────── Access control ─────────
ALLOW_REGISTRATION=true
# Domains granted to newly registered users (leave empty to require admin approval)
DEFAULT_DOMAIN_GRANTS=students,ecommerce,helpdesk
SESSION_TTL_HOURS=12
AUTH_ATTEMPTS_PER_MINUTE=8
CHAT_REQUESTS_PER_MINUTE=20

# ───────── Query limits ─────────
QUERY_TIMEOUT_MS=5000
DEFAULT_ROW_LIMIT=25
MAX_ROW_LIMIT=200
LLM_MAX_ROWS=30
HISTORY_MESSAGES=12
SCHEMA_CACHE_TTL_SECONDS=600

# ───────── Optional: document Q&A (RAG) ─────────
RAG_ENABLED=false
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
MAX_UPLOAD_MB=10
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
